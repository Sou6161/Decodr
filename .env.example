# ──────────────────────────────────────────────────────────────
# Decodr environment — copy to .env and fill in.
# Loaded by apps/api. The web app reads only VITE_* vars.
# ──────────────────────────────────────────────────────────────

# Backend
NODE_ENV=development
API_PORT=4000
# Comma-separated origins allowed by CORS
WEB_ORIGIN=http://localhost:5173

# Database (local Homebrew PostgreSQL 17). Include your DB role explicitly —
# e.g. your macOS username — so Prisma's driver authenticates correctly.
DATABASE_URL=postgresql://USER@localhost:5432/decodr?schema=public

# File storage (where uploaded ZIPs are extracted)
STORAGE_DIR=./storage
MAX_UPLOAD_MB=500

# AI provider abstraction. Provider is one of: openai | claude | gemini | ollama
AI_PROVIDER=openai
# A namespaced OpenRouter model. Trade-offs measured on a Quick-mode question:
#   openai/gpt-4o-mini                      ~5s,  paid,  128k context
#   nvidia/nemotron-3-ultra-550b-a55b:free  ~50s, free,  1M context
# The NVIDIA free endpoint logs session data to improve NVIDIA products, so do
# not point it at code you have promised to keep private.
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENAI_API_KEY=
# Optional: point at an OpenAI-compatible gateway. Leave blank to use OpenAI
# directly. For OpenRouter use https://openrouter.ai/api/v1.
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Tried in order when the model above fails with an overload, a rate limit or
# exhausted credits. Free pools are shared and rate-limit without warning, so a
# second model is what keeps the demo answering.
AI_FALLBACK_MODELS=poolside/laguna-s-2.1:free,openai/gpt-4o-mini
AI_SITE_NAME=Decodr
# Enable OpenRouter reasoning (reasoning: { enabled: true }). Slower; pairs well
# with openrouter/free which routes to reasoning-capable models.
AI_REASONING=false

# Frontend (Vite) — must be prefixed with VITE_
VITE_API_BASE_URL=http://localhost:4000
# Client-side upload size guard (should match MAX_UPLOAD_MB)
VITE_MAX_UPLOAD_MB=500
